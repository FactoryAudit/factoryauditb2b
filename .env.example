# ===== FactoryAuditB2B 环境变量示例 =====
# 复制为 .env 并填入真实值。
# V2.0 起：无数据库、无登录、无 admin 后台，DB / Auth 相关变量已全部移除。

# ---- 真实 AI (DeepSeek) ----
# 在 platform.deepseek.com 获取。留空则所有 AI 工具自动回退本地规则引擎。
DEEPSEEK_API_KEY=""

# ---- 邮件通知 —— 商用必填，否则线索完全不发邮件 ----
# Cloudflare Workers 禁止 SMTP 出站（25/465/587 被拦截），生产必须走 HTTP API。
# 推荐 Resend：免费 100 封/天，不要信用卡。
#   1. resend.com 注册 → API Keys → Create API Key → 复制 re_ 开头的 key
#   2. 域名未验证前，FROM_EMAIL 只能用内置的 onboarding@resend.dev
#      （限制：只能发给注册 Resend 的那个邮箱）
#   3. 要发给任意客户：Domains → Add Domain → 按提示加 3 条 DNS 记录，验证通过后
#      FROM_EMAIL 改回 support@factoryauditb2b.com
MAIL_PROVIDER="http"
MAIL_HTTP_URL="https://api.resend.com/emails"
MAIL_HTTP_KEY=""
# 管理员收件邮箱（新线索通知发到这里）
NOTIFY_ADMIN_EMAIL="admin@factoryauditb2b.com"
# 发件地址
FROM_EMAIL="onboarding@resend.dev"
# SMTP 参数（仅本地 dev 用，生产忽略）
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# ---- 前端公开变量（构建期内联到客户端 bundle，须在构建环境配置） ----
# WhatsApp 国际格式不带 +，未配置时按钮自动隐藏
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ---- 搜索引擎验证（可选，缺省不影响构建） ----
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
