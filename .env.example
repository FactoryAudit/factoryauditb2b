# ===== FactoryAuditB2B 环境变量示例 =====
# 复制为 .env 并填入真实值。
#
# V2.1 起：引入 Supabase（Auth + PostgreSQL）与 Stripe 订阅支付。
# 未配置的部分会自动 fail-open 降级（站点照常运行，相关功能不可用），
# 所以可以分阶段填：先配 Supabase 跑通账号，再配 Stripe 跑通收款。
#
# ⚠️ 安全分级：
#   NEXT_PUBLIC_*  —— 构建期内联进客户端 bundle，会在浏览器里可见。
#                     只能放公开标识符（URL、anon key）。改完必须重新构建+部署才生效。
#   其它           —— 服务端专用。生产环境用 `wrangler secret put` 写到 Workers secrets，
#                     不要只写在 .env（.env 被 gitignore，部署时不会上传）。

# ---- 真实 AI (DeepSeek) ----
# 在 platform.deepseek.com 获取。留空则所有 AI 工具自动回退本地规则引擎。
DEEPSEEK_API_KEY=""

# ---- 邮件通知 —— 商用必填，否则线索完全不发邮件 ----
# Cloudflare Workers 禁止 SMTP 出站（25/465/587 被拦截），生产必须走 HTTP API。
# 推荐 Resend：免费 100 封/天，不要信用卡。
#   1. resend.com 注册 → API Keys → Create API Key → 复制 re_ 开头的 key
#   2. 域名未验证前，FROM_EMAIL 只能用内置的 onboarding@resend.dev
#      （限制：只能发给注册 Resend 的那个邮箱）
#   3. 要发给任意客户：Domains → Add Domain → 按提示加 3 条 DNS 记录，验证通过后
#      FROM_EMAIL 改回 support@factoryauditb2b.com
MAIL_PROVIDER="http"
MAIL_HTTP_URL="https://api.resend.com/emails"
MAIL_HTTP_KEY=""
# 管理员收件邮箱（新线索通知发到这里）
NOTIFY_ADMIN_EMAIL="admin@factoryauditb2b.com"
# 发件地址
FROM_EMAIL="onboarding@resend.dev"
# SMTP 参数（仅本地 dev 用，生产忽略）
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# ============================================================================
# V2.1 —— Supabase（Auth + PostgreSQL）
# ============================================================================
# 建项目：supabase.com → New project
# 建表：  SQL Editor 里执行 supabase/migrations/001_init.sql
# 取值：  Project Settings → API

# Project URL（公开，可进 bundle）
NEXT_PUBLIC_SUPABASE_URL=""
# anon / public key（公开，安全由 RLS 保证 —— 所以建表脚本里的 RLS 不是可选项）
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# service_role key —— ⚠️ 绕过全部 RLS，全库读写权限。
#   只能用 wrangler secret put 写进 Workers，绝不写 .env，绝不加 NEXT_PUBLIC_ 前缀。
#   自检：grep -rn "SUPABASE_SERVICE_ROLE_KEY" --include="*.ts*" .
#        除本文件外任何地方命中即为安全事故。
SUPABASE_SERVICE_ROLE_KEY=""

# 供应商数据源开关（迁移保险丝）：
#   "static"   → 强制读 lib/staticData.ts 静态常量（Supabase 故障时的紧急回落）
#   "supabase" → 读数据库；未配置或查询失败时自动回落静态
# 留空 = 自动（未配置则静态）。
# 生产环境用 wrangler secret put 设置，改完无需重新构建，5 分钟内生效。
SUPPLIER_DATA_SOURCE=""

# ============================================================================
# V2.1 —— Stripe（$99/year Founding Buyer 订阅）
# ============================================================================
# ⚠️ 前置：Stripe 不支持中国大陆个人主体。需 HK / US / SG 等主体。
#    三个键全部用 wrangler secret put 写 Workers，不要只写 .env。

# Secret key（sk_live_ / sk_test_ 开头）
STRIPE_SECRET_KEY=""
# Webhook 签名密钥（whsec_ 开头）。
# 不填 = 所有 webhook 一律拒绝 → 用户付了钱会员也不会自动开通。
STRIPE_WEBHOOK_SECRET=""
# $99/年 订阅的 Price ID（price_ 开头）
# 位置：Stripe Dashboard → Products → Founding Buyer Membership → 价格 → 复制价格 ID
STRIPE_PRICE_ID_FOUNDING_BUYER=""

# ---- 站点地址（Stripe 成功/取消回跳用）----
# 本地开发改成 http://localhost:3000；生产写 https://factoryauditb2b.com
# 注意：这是 NEXT_PUBLIC_，改完必须重新构建才生效。
NEXT_PUBLIC_SITE_URL="https://factoryauditb2b.com"

# ============================================================================
# 前端公开变量（构建期内联，改完必须重新构建 + 部署）
# ============================================================================
# WhatsApp 国际格式不带 +，未配置时按钮自动隐藏
NEXT_PUBLIC_WHATSAPP_NUMBER=""
# GA4 Measurement ID（G- 开头）。不符合格式则不注入任何脚本（零脚本，不是报错）
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
# Cloudflare Web Analytics beacon token（32 位 hex）。需在 CF Dashboard 手动开启 RUM
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=""
# 埋点调试：设为 1 会在 console 打印每个事件（生产不要开）
NEXT_PUBLIC_ANALYTICS_DEBUG=""

# ---- Google Sheets CRM（可选，留空则跳过不报错）----
# register / signup 线索会双写一份到表格，便于运营在熟悉的工具里跟进。
# 建法：Google Sheet → 扩展程序 → Apps Script → 部署为 Web App（任何人可访问）
GOOGLE_SHEETS_REGISTER_WEBHOOK=""

# ---- 搜索引擎验证（可选，缺省不影响构建） ----
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
