# =============================================================================
# FactoryAuditB2B — 宝塔自托管（Node）生产环境变量模板
#
# 用法：复制为 <项目根>/.env.production，填入真实值。
#   自托管时 Next 的 `next start` / standalone `server.js` 会读取它。
#
# 🔴 安全：
#   1. 本文件只放**键名与说明**，绝不放真实密钥；填好的 .env.production 不要进 git。
#   2. `SUPABASE_SERVICE_ROLE_KEY` 是可读写全库的钥匙 —— 只能服务端用，
#      绝不能加 NEXT_PUBLIC_ 前缀（加了会被打进浏览器产物）。
#   3. `SUPABASE_ACCESS_TOKEN` / `CLOUDFLARE_*` **不需要**放在本文件：
#      它们只在本地跑迁移/部署脚本时用，服务器上没有任何代码读它们。
# =============================================================================

# ── 运行时 ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# 只监听本机回环，由 nginx 反代对外暴露。
# 设成 0.0.0.0 会让 3000 端口直接暴露在公网（绕过 nginx 的 SSL 与限流）。
HOSTNAME=127.0.0.1

# ── 站点 ──────────────────────────────────────────────────────────────────────
# 影响 canonical / hreflang / sitemap / 支付回跳地址，必须与真实域名完全一致（含 https，不带尾斜杠）
NEXT_PUBLIC_SITE_URL=https://factoryauditb2b.com

# ── 数据库（Supabase 云端；自托管**不需要**在服务器装 Postgres）──────────────
# supabase = 读数据库（生产必须用这个）
# static   = 回退到内置静态常量（5 秒回滚保险丝，数据是旧的）
SUPPLIER_DATA_SOURCE=supabase

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端专用，绕 RLS。绝不加 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=

# ── 邮件 ──────────────────────────────────────────────────────────────────────
# http = 走 Resend 等 HTTP API（推荐，不依赖服务器出站 25/465/587 端口）
# smtp = 走 SMTP（自托管可用，但部分云厂商封 25 端口）
MAIL_PROVIDER=http
MAIL_HTTP_URL=
MAIL_HTTP_KEY=
FROM_EMAIL=
NOTIFY_ADMIN_EMAIL=

# ── 支付（打通「付费会员」必须）──────────────────────────────────────────────
# ⚠️ 四个 PAYPAL_ 值全部留空时：/pricing 的「Become a Founding Buyer」按钮会
#    自动降级到人工对接页（不报错、不白屏），但**不会产生任何付费会员**。
#    想真正收费，必须至少填 CLIENT_ID + SECRET + WEBHOOK_ID。
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 可选。留空 ⇒ 走「一次性年费」（$99/年，到期手动续，无自动扣款义务）。
# 填了 ⇒ 走「订阅自动续费」，前提是你已在 PayPal 后台建好该年费 Plan。
PAYPAL_PLAN_ID=
# 必填。缺它时 lib/payments/paypal.ts 会拒绝**所有** webhook（验签无法进行），
# 表现为「用户付了钱但会员永远不开通」。
PAYPAL_WEBHOOK_ID=

# Stripe 为备选渠道（不支持中国大陆主体）。不打算用可全部留空。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_FOUNDING_BUYER=

# ── 人工收款信息（/custom-services 展示）────────────────────────────────────
PAYMENT_BANK_DETAILS=

# ── AI 客服（可选；留空则回落本地化关键词知识库）─────────────────────────────
DEEPSEEK_API_KEY=

# ── 运营主体登记信息（可选）──────────────────────────────────────────────────
# 留空时 /trust 仍会显示法定名（lib/aboutContent.ts 的真实值兜底），
# 以下每一项**未配置就逐项不输出** —— 绝不用占位值顶替，也绝不编造。
TRUST_LEGAL_ENTITY=
TRUST_CONTACT_EMAIL=
TRUST_REGISTRATION_NUMBER=
TRUST_REGISTRATION_AUTHORITY=
TRUST_REGISTRATION_STATUS=
TRUST_REGISTRATION_YEAR=
TRUST_REGISTERED_ADDRESS=
TRUST_CITY=
TRUST_COUNTRY=
TRUST_LEGAL_REP=
TRUST_VERIFICATION_DATE=
TRUST_DOCUMENT_ID=
TRUST_LICENSE_IMAGE=

# ── 其它 ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=
GOOGLE_SHEETS_REGISTER_WEBHOOK=
FROM_EMAIL=
