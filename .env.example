# ===== FactoryAuditB2B 环境变量示例 =====
# 复制为 .env 并填入真实值。生产环境务必替换密钥。

# ---- 数据库 ----
# 本地开发（默认）：SQLite，零依赖
DATABASE_URL="file:./dev.db"
# 生产（Cloudflare Workers + Neon Postgres）：用 Neon 控制台的 Pooled 连接串（带 -pooler），末尾加 ?sslmode=require
# DATABASE_URL="postgresql://user:pass@xxx-pooler.neon.tech/dbname?sslmode=require"
# 生产专用：Neon Direct 直连串，prisma migrate / db:seed 用（绕开 PgBouncer 事务池限制）
# DATABASE_URL_UNPOOLED="postgresql://user:pass@xxx.neon.tech/dbname?sslmode=require"
# （切库用 npm run db:postgres / db:sqlite，会同步改 schema.prisma 并维护 directUrl 字段）

# ---- 鉴权 (NextAuth v5) ----
# 本地用 openssl rand -base64 32 生成；生产换强随机值
# NextAuth v5 会话签名密钥（生产环境必填，缺失会导致登录失效或会话可被伪造）。
# 生成方式（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
AUTH_SECRET=""
# 本地 http://localhost:3000；生产改成你的正式域名 https://factoryauditb2b.com
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth（可选，但商用建议配置）。
# 在 Google Cloud Console 建 OAuth 客户端后填入；
# 配置 OAuth 同意屏幕时必须填「隐私政策网址」→ 本站 /privacy。
# 留空则登录页只显示邮箱/密码（演示账号），不显示 Google 按钮。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- 真实 AI (DeepSeek) ----
# 在 platform.deepseek.com 获取。留空则所有 AI 工具自动回退本地规则引擎。
DEEPSEEK_API_KEY=""

# ---- 邮件通知 —— 商用必填，否则线索只落库不发邮件 ----
# 模式选择：
#   MAIL_PROVIDER="smtp" → SMTP 服务商（本地开发 / 自建服务器）
#   MAIL_PROVIDER="http" → HTTP API 邮件（Cloudflare Workers 生产必选！
#       ⚠️ Workers 平台禁止 SMTP 出站（25/465/587 端口被拦截），必须走 HTTP API）
# HTTP 模式兼容 Resend 格式：https://resend.com 注册（免费 100 封/天）→ API Keys 页拿 key
#   也可换 SendGrid/Mailgun/腾讯云邮件推送，改 lib/notify.ts 的 sendMailHttp 即可
MAIL_PROVIDER="smtp"
MAIL_HTTP_URL="https://api.resend.com/emails"
MAIL_HTTP_KEY=""
#
# SMTP 模式参考配置（任选一家）：
#
# ① Gmail（开启两步验证后建「应用专用密码」）
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="应用专用密码"
#
# ② 腾讯企业邮 / QQ 邮箱（SSL）
# SMTP_HOST="smtp.exmail.qq.com"   # 个人QQ: smtp.qq.com
# SMTP_PORT=465  # 用 465 时系统自动启用 SSL
# SMTP_USER="you@yourdomain.com"
# SMTP_PASS="授权码"
#
# ③ SendGrid（API Key 作密码，用户名固定 "apikey"）
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="SG.xxxx"
#
# ④ Aliyun 邮件推送 / 阿里云企业邮
# SMTP_HOST="smtpdm.aliyun.com"
# SMTP_PORT=465
# SMTP_USER="noreply@yourdomain.com"
# SMTP_PASS="授权码"
#
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# 管理员收件邮箱（新线索通知发到这里，必填才会发）
NOTIFY_ADMIN_EMAIL="admin@factoryauditb2b.com"
# 发件地址（建议用你域名下的 noreply 邮箱，提升送达率）
FROM_EMAIL="support@factoryauditb2b.com"

# ---- 前端公开变量（构建期内联到客户端 bundle，须在构建环境配置） ----
# WhatsApp 国际格式不带 +，未配置时按钮自动隐藏
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ---- 搜索引擎验证（可选，缺省不影响构建） ----
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
